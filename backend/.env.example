# ══════════════════════════════════════════════════════════
# LunchSync 백엔드 환경 변수 템플릿
#
# 사용법: 이 파일을 복사해서 .env 로 저장 후 값을 채워주세요
#   cp .env.example .env
# ══════════════════════════════════════════════════════════

PORT=3000

SUPABASE_URL=https://<your-project-id>.supabase.co
# Server only. Never expose this value to Flutter, browsers, logs, or commits.
SUPABASE_SERVICE_ROLE_KEY=<your-server-only-service-role-key>

JWT_SECRET=<strong-random-secret>
JWT_EXPIRES_IN=7d

# ══════════════════════════════════════════════════════════
# 토스페이먼츠 (https://developers.tosspayments.com/)
# ══════════════════════════════════════════════════════════
TOSS_SECRET_KEY=<your-toss-test-secret-key>
TOSS_API_BASE_URL=https://api.tosspayments.com

# ══════════════════════════════════════════════════════════
# 네이버 검색 API (https://developers.naver.com)
# 애플리케이션 등록 후 Client ID / Secret 확인
# ══════════════════════════════════════════════════════════
NAVER_CLIENT_ID=<your-naver-client-id>
NAVER_CLIENT_SECRET=<your-naver-client-secret>

# ══════════════════════════════════════════════════════════
# 카카오 로컬 API (https://developers.kakao.com)
# 앱 키 → REST API 키 확인
# ══════════════════════════════════════════════════════════
KAKAO_REST_API_KEY=<your-kakao-rest-api-key>
