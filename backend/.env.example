# ══════════════════════════════════════════════════════════
# LunchSync 백엔드 환경 변수 템플릿
#
# 사용법: 이 파일을 복사해서 .env 로 저장 후 값을 채워주세요
#   cp .env.example .env
# ══════════════════════════════════════════════════════════

PORT=3000

SUPABASE_URL=https://<your-project-id>.supabase.co
# Server only. Never expose this value to Flutter, browsers, logs, or commits.
SUPABASE_SERVICE_ROLE_KEY=<your-server-only-service-role-key>
# OTP Auth 전용 최소권한 키. 미설정 시 호환을 위해 service-role 키를 쓰지만,
# 운영 환경에서는 프로젝트 anon/publishable key를 별도로 설정하세요.
SUPABASE_ANON_KEY=<your-supabase-anon-or-publishable-key>

JWT_SECRET=<strong-random-secret>
JWT_EXPIRES_IN=7d

# 비운영 POS 시연에서만 true. production에서는 true여도 서버가 거절합니다.
POS_SHARED_PIN_LOGIN_ENABLED=false
POS_PIN=<non-production-demo-pin>

# 비운영 환경에서도 명시적으로 true일 때만 모의 결제를 허용합니다.
ALLOW_SIMULATED_PAYMENTS=false

# 실제 결제 주문에는 적용되지 않는 로컬 환불 데모 전용 플래그입니다.
ALLOW_REFUND_SIMULATION=false

# 실제 단말 연동 전 CARD POS 결제 시뮬레이션은 로컬에서만 명시적으로 켭니다.
ALLOW_POS_CARD_SIMULATION=false

# ══════════════════════════════════════════════════════════
# 토스페이먼츠 (https://developers.tosspayments.com/)
# ══════════════════════════════════════════════════════════
TOSS_SECRET_KEY=<your-toss-test-secret-key>
TOSS_API_BASE_URL=https://api.tosspayments.com
TOSS_API_TIMEOUT_MS=10000

# ══════════════════════════════════════════════════════════
# 네이버 검색 API (https://developers.naver.com)
# 애플리케이션 등록 후 Client ID / Secret 확인
# ══════════════════════════════════════════════════════════
NAVER_CLIENT_ID=<your-naver-client-id>
NAVER_CLIENT_SECRET=<your-naver-client-secret>

# ══════════════════════════════════════════════════════════
# 카카오 로컬 API (https://developers.kakao.com)
# 앱 키 → REST API 키 확인
# ══════════════════════════════════════════════════════════
KAKAO_REST_API_KEY=<your-kakao-rest-api-key>

# Kakao login token must belong to this Developers app (not an API key).
KAKAO_APP_ID=1534395
KAKAO_API_TIMEOUT_MS=5000
